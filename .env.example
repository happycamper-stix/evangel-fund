# Public development cluster and deployed addresses; never use mainnet here.
NEXT_PUBLIC_EVANGEL_SOLANA_CLUSTER=devnet
EVANGEL_SOLANA_PROGRAM=
EVANGEL_GOVERNANCE_MULTISIG=
# Server-only RPC configuration. Public defaults shown; provider keys belong in .env.local.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_TESTNET_RPC_URL=https://api.testnet.solana.com
# Obtain these from your own Clerk app. Only the publishable key is client-visible.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AI_GATEWAY_API_KEY=
EVANGEL_AGENT_MODEL=
EVANGEL_PROVIDER_RATE_LIMIT_ID=
# Never put wallet signing keys in app configuration or Vercel.
